daemonize
show-failed-attempts
clock
screenshot
effect-blur=15x15
effect-vignette=1:1
font=FantasqueSansM Nerd Font
indicator
indicator-radius=110
indicator-thickness=5

# Primary Colors from Palette
line-color=#d0524f
ring-color=#c41f5b
inside-color=#320f30

# Highlight Colors
key-hl-color=#ffffff
bs-hl-color=#ffffff

# Separator and Text Colors
separator-color=#24122a
text-color=#c41f5b
text-caps-lock-color=#d0524f

# Verification Colors
line-ver-color=#d0524f
ring-ver-color=#c41f5b
inside-ver-color=#320f30
text-ver-color=#c41f5b

# Wrong Password Colors
ring-wrong-color=#c41f5b
text-wrong-color=#c41f5b
inside-wrong-color=#320f30
line-wrong-color=#c41f5b

# Clear State Colors
inside-clear-color=#320f30
text-clear-color=#d0524f
ring-clear-color=#c41f5b
line-clear-color=#c41f5b

# Additional Settings
bs-hl-color=#d0524f
grace=4
grace-no-mouse
grace-no-touch
datestr=%a, %B %e
timestr=%I:%M %p
fade-in=0.1
ignore-empty-password
